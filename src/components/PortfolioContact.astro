---
interface Props {
  locale?: 'en' | 'es';
  email?: string;
  linkedinUrl?: string;
  githubUrl?: string;
  hacksterUrl?: string;
  instagramUrl?: string;
  orcidUrl?: string;
}

const {
  locale = 'en',
  email = 'wicholuiz29@gmail.com',
  linkedinUrl = '',
  githubUrl = '',
  hacksterUrl = '',
  instagramUrl = '',
  orcidUrl = ''
} = Astro.props;

const isEs = locale === 'es';

const title = isEs ? 'Contacto' : 'Contact';
const kicker = isEs ? 'Conexión directa' : 'Direct connection';

const subtitle = isEs
  ? '¿Te interesa colaborar en investigación, IA, visión computacional, electrónica o desarrollo de sistemas inteligentes? Puedes escribirme directamente o contactarme por mis redes profesionales.'
  : 'Interested in research collaboration, AI, computer vision, electronics, or intelligent systems development? Feel free to reach out directly or connect through my professional networks.';

const sendEmail = isEs ? 'Enviar correo' : 'Send email';
const openGmail = isEs ? 'Abrir en Gmail' : 'Open in Gmail';
const copyEmail = isEs ? 'Copiar correo' : 'Copy email';
const copiedText = isEs ? 'Correo copiado' : 'Email copied';

const availabilityTitle = isEs ? 'Disponibilidad' : 'Availability';
const availabilityText = isEs
  ? 'Abierto a colaboraciones académicas, proyectos de I+D, consultoría técnica, conferencias y desarrollo orientado a IA.'
  : 'Open to academic collaborations, R&D projects, technical consulting, talks, and AI-oriented development.';

const focusTitle = isEs ? 'Enfoque' : 'Focus';
const focusText = isEs
  ? 'Investigación, IA, visión computacional, sistemas embebidos, analítica, electrónica y tecnología aplicada.'
  : 'Research, AI, computer vision, embedded systems, analytics, electronics, and applied technology.';

const mailtoHref = `mailto:${email}?subject=${encodeURIComponent(
  isEs ? 'Consulta desde portafolio' : 'Portfolio inquiry'
)}&body=${encodeURIComponent(isEs ? 'Hola Luis,' : 'Hello Luis,')}`;

const gmailHref = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(email)}&su=${encodeURIComponent(
  isEs ? 'Consulta desde portafolio' : 'Portfolio inquiry'
)}&body=${encodeURIComponent(isEs ? 'Hola Luis,' : 'Hello Luis,')}`;

const networks = [
  { label: 'LinkedIn', url: linkedinUrl },
  { label: 'GitHub', url: githubUrl },
  { label: 'Hackster', url: hacksterUrl },
  { label: 'Instagram', url: instagramUrl },
  { label: 'ORCID', url: orcidUrl }
].filter((item) => item.url && item.url.trim().length > 0);
---

<section id="contact" class="mt-24 mb-20">
  <div class="border-b border-slate-800 pb-4 mb-10">
    <p class="text-xs font-bold text-cyan-400 uppercase tracking-[0.3em] mb-2">{kicker}</p>
    <h2 class="text-3xl font-bold text-white">{title}</h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-6">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 relative overflow-hidden">
      <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_top_right,rgba(34,211,238,0.20),transparent_35%)]"></div>

      <div class="relative z-10">
        <p class="text-slate-300 text-base leading-relaxed max-w-3xl">
          {subtitle}
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={mailtoHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-xl border border-cyan-500/40 bg-cyan-500/10 px-4 py-3 text-sm font-semibold text-cyan-300 hover:bg-cyan-500/20 transition"
          >
            {sendEmail}
          </a>

          <a
            href={gmailHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-xl border border-slate-700 bg-slate-800/80 px-4 py-3 text-sm font-semibold text-white hover:border-cyan-500/40 hover:text-cyan-300 transition"
          >
            {openGmail}
          </a>

          <button
            type="button"
            id={`copy-email-${locale}`}
            data-email={email}
            class="inline-flex items-center rounded-xl border border-slate-700 bg-slate-800/80 px-4 py-3 text-sm font-semibold text-white hover:border-emerald-500/40 hover:text-emerald-300 transition"
          >
            {copyEmail}
          </button>
        </div>

        <p id={`copy-feedback-${locale}`} class="mt-3 text-sm text-emerald-300 opacity-0 transition-opacity duration-300">
          {copiedText}
        </p>

        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-slate-500 mb-2">
              {isEs ? 'Correo principal' : 'Primary email'}
            </p>
            <p class="text-white font-medium break-all">{email}</p>
          </div>

          <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
            <p class="text-xs uppercase tracking-[0.25em] text-slate-500 mb-2">{availabilityTitle}</p>
            <p class="text-slate-300 text-sm leading-relaxed">{availabilityText}</p>
          </div>

          <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4 md:col-span-2">
            <p class="text-xs uppercase tracking-[0.25em] text-slate-500 mb-2">{focusTitle}</p>
            <p class="text-slate-300 text-sm leading-relaxed">{focusText}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
      <p class="text-xs font-bold text-purple-300 uppercase tracking-[0.25em] mb-4">
        {isEs ? 'Redes y perfiles' : 'Networks & profiles'}
      </p>

      <div class="flex flex-col gap-3">
        {networks.map((network) => (
          <a
            href={network.url}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl border border-slate-700 bg-slate-950/60 px-4 py-4 text-white hover:border-cyan-500/40 hover:text-cyan-300 transition"
          >
            {network.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script define:vars={{ locale }}>
  const copyBtn = document.getElementById(`copy-email-${locale}`);
  const feedback = document.getElementById(`copy-feedback-${locale}`);

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || '';

      try {
        await navigator.clipboard.writeText(email);
        if (feedback) {
          feedback.classList.remove('opacity-0');
          feedback.classList.add('opacity-100');
          setTimeout(() => {
            feedback.classList.remove('opacity-100');
            feedback.classList.add('opacity-0');
          }, 1800);
        }
      } catch {
        window.prompt('Copy this email:', email);
      }
    });
  }
</script>
---
const equations = [
  "∂L/∂w",
  "softmax(z)",
  "P(y|x)",
  "Σwᵢxᵢ",
  "FFT(x)",
  "Bayes",
  "H(s)",
  "f(x)=Wx+b",
  "∇θ",
  "ReLU(x)"
];
---

<div class="research-bg" aria-hidden="true">
  <canvas id="research-bg-canvas"></canvas>

  <div class="math-layer">
    {equations.map((eq, i) => (
      <span class={`math-token math-token-${i}`}>{eq}</span>
    ))}
  </div>

  <div class="fractal-ring ring-one"></div>
  <div class="fractal-ring ring-two"></div>
</div>

<style>
  .research-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 20%, rgba(34, 211, 238, 0.16), transparent 32%),
      radial-gradient(circle at 80% 25%, rgba(168, 85, 247, 0.14), transparent 32%),
      radial-gradient(circle at 45% 85%, rgba(16, 185, 129, 0.10), transparent 34%),
      #020617;
  }

  #research-bg-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 1;
  }

  .math-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .math-token {
    position: absolute;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
    color: rgba(125, 211, 252, 0.22);
    text-shadow: 0 0 18px rgba(34, 211, 238, 0.32);
    animation: mathFloat 16s ease-in-out infinite;
    white-space: nowrap;
  }

  .math-token-0 { top: 10%; left: 8%; }
  .math-token-1 { top: 17%; right: 12%; animation-delay: 1s; }
  .math-token-2 { top: 33%; left: 16%; animation-delay: 2s; }
  .math-token-3 { top: 43%; right: 18%; animation-delay: 3s; }
  .math-token-4 { top: 58%; left: 9%; animation-delay: 4s; }
  .math-token-5 { top: 68%; right: 15%; animation-delay: 5s; }
  .math-token-6 { top: 80%; left: 31%; animation-delay: 2.5s; }
  .math-token-7 { top: 25%; left: 52%; animation-delay: 3.5s; }
  .math-token-8 { top: 52%; left: 60%; animation-delay: 1.5s; }
  .math-token-9 { top: 86%; right: 30%; animation-delay: 4.5s; }

  @keyframes mathFloat {
    0%, 100% { transform: translateY(0) scale(1); opacity: 0.12; }
    50% { transform: translateY(-18px) scale(1.08); opacity: 0.32; }
  }

  .fractal-ring {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 999px;
    border: 1px solid rgba(34, 211, 238, 0.12);
    box-shadow:
      0 0 40px rgba(34, 211, 238, 0.10),
      inset 0 0 30px rgba(168, 85, 247, 0.08);
    animation: ringPulse 12s ease-in-out infinite;
  }

  .ring-one {
    top: 12%;
    right: 9%;
  }

  .ring-two {
    bottom: 10%;
    left: 8%;
    width: 260px;
    height: 260px;
    animation-delay: 3s;
  }

  @keyframes ringPulse {
    0%, 100% { transform: translateY(0) scale(1); opacity: 0.18; }
50% { transform: translateY(-24px) scale(1.12); opacity: 0.45; }
  }

  @media (max-width: 768px) {
    #research-bg-canvas {
      opacity: 0.65;
    }

    .math-token {
      font-size: 0.68rem;
      opacity: 0.16;
    }

    .fractal-ring {
      opacity: 0.16;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .math-token,
    .fractal-ring {
      animation: none !important;
    }
  }
</style>

<script>
  const canvas = document.getElementById('research-bg-canvas');

  if (canvas) {
    const ctx = canvas.getContext('2d');
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.innerWidth < 768;

    let nodes = [];
    let frame = 0;
    let animationId;

    const count = reduceMotion ? 28 : isMobile ? 46 : 105;
    const maxDistance = isMobile ? 130 : 190;

    function resize() {
      canvas.width = window.innerWidth * dpr;
      canvas.height = window.innerHeight * dpr;
      canvas.style.width = `${window.innerWidth}px`;
      canvas.style.height = `${window.innerHeight}px`;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      nodes = Array.from({ length: count }, (_, i) => ({
        x: Math.random() * window.innerWidth,
        y: Math.random() * window.innerHeight,
        vx: (Math.random() - 0.5) * (isMobile ? 0.24 : 0.46),
        vy: (Math.random() - 0.5) * (isMobile ? 0.24 : 0.46),
        r: Math.random() * 2.2 + 1,
        phase: Math.random() * Math.PI * 2,
        special: i % 9 === 0
      }));
    }

    function drawTrainingWave() {
      const baseY = window.innerHeight * 0.72;
      ctx.beginPath();

      for (let x = 0; x <= window.innerWidth; x += 10) {
        const y =
          baseY +
          Math.sin(x * 0.015 + frame * 0.035) * 18 +
          Math.sin(x * 0.035 + frame * 0.018) * 8;

        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }

      ctx.strokeStyle = 'rgba(168, 85, 247, 0.28)';
        ctx.lineWidth = 2.4;
      ctx.stroke();
      ctx.beginPath();

for (let x = 0; x <= window.innerWidth; x += 10) {
  const y =
    window.innerHeight * 0.58 +
    Math.cos(x * 0.018 + frame * 0.028) * 14 +
    Math.sin(x * 0.045 + frame * 0.016) * 6;

  if (x === 0) ctx.moveTo(x, y);
  else ctx.lineTo(x, y);
}

ctx.strokeStyle = 'rgba(34, 211, 238, 0.22)';
ctx.lineWidth = 1.6;
ctx.stroke();
    }

    function draw() {
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

      drawTrainingWave();

      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;

        if (n.x < -20 || n.x > window.innerWidth + 20) n.vx *= -1;
        if (n.y < -20 || n.y > window.innerHeight + 20) n.vy *= -1;

        const pulse = 0.5 + Math.sin(frame * 0.035 + n.phase) * 0.5;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r + pulse * 1.2, 0, Math.PI * 2);
        ctx.fillStyle = n.special
          ? `rgba(34, 211, 238, ${0.28 + pulse * 0.35})`
          : `rgba(148, 163, 184, ${0.18 + pulse * 0.16})`;
        ctx.fill();
      }

      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < maxDistance) {
            const alpha = (1 - dist / maxDistance) * 0.18;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.strokeStyle = `rgba(56, 189, 248, ${alpha})`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
      }

      frame++;
      animationId = requestAnimationFrame(draw);
    }

    resize();
    draw();

    window.addEventListener('resize', resize);
    window.addEventListener('beforeunload', () => cancelAnimationFrame(animationId));
  }
</script>
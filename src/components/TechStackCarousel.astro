---
interface Props {
  locale?: 'en' | 'es';
}

const { locale = 'en' } = Astro.props;
const isEs = locale === 'es';

const stack = [
  { name: 'Python', icon: 'https://cdn.simpleicons.org/python', code: 'PY' },
  { name: 'TensorFlow', icon: 'https://cdn.simpleicons.org/tensorflow', code: 'TF' },
  { name: 'PyTorch', icon: 'https://cdn.simpleicons.org/pytorch', code: 'PT' },
  { name: 'OpenCV', icon: 'https://cdn.simpleicons.org/opencv', code: 'CV' },
  { name: 'YOLO / Computer Vision', icon: 'https://cdn.simpleicons.org/opencv', code: 'YOLO' },
  { name: 'MediaPipe / Google AI', icon: 'https://cdn.simpleicons.org/google', code: 'G' },
  { name: 'Astro', icon: 'https://cdn.simpleicons.org/astro', code: 'AST' },
  { name: 'Tailwind CSS', icon: 'https://cdn.simpleicons.org/tailwindcss', code: 'TW' },
  { name: 'PostgreSQL', icon: 'https://cdn.simpleicons.org/postgresql', code: 'SQL' },
  { name: 'Firebase', icon: 'https://cdn.simpleicons.org/firebase', code: 'FB' },
  { name: 'Arduino', icon: 'https://cdn.simpleicons.org/arduino', code: 'ARD' },
  { name: 'ESP32 / Espressif', icon: 'https://cdn.simpleicons.org/espressif', code: 'ESP' },
  { name: 'NVIDIA / Jetson', icon: 'https://cdn.simpleicons.org/nvidia', code: 'GPU' },
  { name: 'Raspberry Pi', icon: 'https://cdn.simpleicons.org/raspberrypi', code: 'RPI' },
  { name: 'KiCad', icon: 'https://cdn.simpleicons.org/kicad', code: 'PCB' },
  { name: 'GitHub', icon: 'https://cdn.simpleicons.org/github', code: 'GIT' },
  { name: 'Docker', icon: 'https://cdn.simpleicons.org/docker', code: 'DOC' },
  { name: 'Linux', icon: 'https://cdn.simpleicons.org/linux', code: 'LNX' },
  { name: 'LaTeX', icon: 'https://cdn.simpleicons.org/latex', code: 'TEX' },
  { name: 'MATLAB', icon: '', code: 'MAT' },
  { name: 'C++', icon: 'https://cdn.simpleicons.org/cplusplus', code: 'C++' },
  { name: 'Flutter', icon: 'https://cdn.simpleicons.org/flutter', code: 'FLT' }
];

const rowA = [...stack, ...stack, ...stack, ...stack];
const rowB = [...stack.slice().reverse(), ...stack.slice().reverse(), ...stack.slice().reverse(), ...stack.slice().reverse()];
---

<section class="mt-20 tsc-section">
  <div class="tsc-card" data-tech-card>
    <div class="tsc-glow"></div>

    <div class="max-w-6xl mx-auto px-6 relative z-20 mb-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <p class="text-xs font-bold text-cyan-300 uppercase tracking-[0.35em]">
          {isEs ? 'Stack tecnológico' : 'Technology Stack'}
        </p>

        <p id={`tech-active-label-${locale}`} class="tech-active-label">
          {isEs ? 'Pasa el cursor sobre un logo' : 'Hover a logo'}
        </p>
      </div>
    </div>

    <div class="tsc-fade">
      <div class="tsc-row">
        <div class="tsc-track tsc-track-left">
          {rowA.map((item) => (
            <div class="tsc-logo" data-label={item.name} data-locale={locale}>
              {item.icon ? (
                <span class="tsc-icon" style={`--icon-url: url("${item.icon}");`}></span>
              ) : (
                <span class="tsc-code">{item.code}</span>
              )}
            </div>
          ))}
        </div>
      </div>

      <div class="tsc-row mt-4">
        <div class="tsc-track tsc-track-right">
          {rowB.map((item) => (
            <div class="tsc-logo" data-label={item.name} data-locale={locale}>
              {item.icon ? (
                <span class="tsc-icon" style={`--icon-url: url("${item.icon}");`}></span>
              ) : (
                <span class="tsc-code">{item.code}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tsc-card {
    position: relative;
    overflow: hidden;
    border-block: 1px solid rgba(51, 65, 85, 0.75);
    background:
      linear-gradient(180deg, rgba(15, 23, 42, 0.54), rgba(2, 6, 23, 0.82)),
      radial-gradient(circle at 20% 40%, rgba(34, 211, 238, 0.10), transparent 32%),
      radial-gradient(circle at 80% 60%, rgba(168, 85, 247, 0.10), transparent 34%);
    padding: 1.45rem 0 1.7rem;
  }

  .tsc-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 560px;
    height: 140px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(34, 211, 238, 0.16), transparent 60%);
    filter: blur(38px);
    opacity: 0.75;
    animation: tscGlow 5s ease-in-out infinite;
  }

  .tech-active-label {
    min-height: 1.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    border: 1px solid rgba(34, 211, 238, 0.22);
    background: rgba(2, 6, 23, 0.70);
    color: rgb(148, 163, 184);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: all 180ms ease;
  }

  .tech-active-label.is-active {
    color: rgb(125, 211, 252);
    border-color: rgba(34, 211, 238, 0.50);
    box-shadow: 0 0 18px rgba(34, 211, 238, 0.12);
  }

  .tsc-fade {
    position: relative;
    overflow: hidden;
    z-index: 20;
  }

  .tsc-fade::before,
  .tsc-fade::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 14%;
    z-index: 40;
    pointer-events: none;
  }

  .tsc-fade::before {
    left: 0;
    background: linear-gradient(90deg, #020617 0%, rgba(2, 6, 23, 0.84) 35%, transparent 100%);
  }

  .tsc-fade::after {
    right: 0;
    background: linear-gradient(270deg, #020617 0%, rgba(2, 6, 23, 0.84) 35%, transparent 100%);
  }

  .tsc-row {
    overflow: hidden;
    width: 100%;
  }

  .tsc-track {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 1.15rem;
    width: max-content;
    min-width: max-content;
    padding-inline: 1.5rem;
    will-change: transform;
  }

  .tsc-track-left {
    animation: tscScrollLeft 55s linear infinite;
  }

  .tsc-track-right {
    animation: tscScrollRight 60s linear infinite;
  }

  .tsc-card:hover .tsc-track-left,
  .tsc-card:hover .tsc-track-right {
    animation-play-state: paused;
  }

  .tsc-logo {
    position: relative;
    width: 58px;
    height: 58px;
    min-width: 58px;
    max-width: 58px;
    min-height: 58px;
    max-height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 1.1rem;
    border: 1px solid rgba(71, 85, 105, 0.76);
    background:
      radial-gradient(circle at top left, rgba(34, 211, 238, 0.15), transparent 50%),
      rgba(15, 23, 42, 0.78);
    box-shadow:
      inset 0 0 18px rgba(34, 211, 238, 0.045),
      0 8px 22px rgba(2, 6, 23, 0.32);
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }

  .tsc-logo:hover {
    transform: translateY(-4px) scale(1.07);
    border-color: rgba(34, 211, 238, 0.72);
    background-color: rgba(15, 23, 42, 0.98);
    box-shadow:
      0 0 0 1px rgba(34, 211, 238, 0.10),
      0 0 24px rgba(34, 211, 238, 0.22),
      0 12px 28px rgba(2, 6, 23, 0.42);
    z-index: 50;
  }

  .tsc-icon {
    display: block;
    width: 27px;
    height: 27px;
    min-width: 27px;
    max-width: 27px;
    min-height: 27px;
    max-height: 27px;
    background: rgb(125, 211, 252);
    -webkit-mask-image: var(--icon-url);
    mask-image: var(--icon-url);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
    filter: drop-shadow(0 0 10px rgba(34, 211, 238, 0.28));
    transition: transform 180ms ease, background 180ms ease;
  }

  .tsc-code {
    color: rgb(125, 211, 252);
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .tsc-logo:hover .tsc-icon,
  .tsc-logo:hover .tsc-code {
    transform: scale(1.12);
    background: white;
    color: white;
  }

  @keyframes tscScrollLeft {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-25%);
    }
  }

  @keyframes tscScrollRight {
    from {
      transform: translateX(-25%);
    }
    to {
      transform: translateX(0);
    }
  }

  @keyframes tscGlow {
    0%, 100% {
      opacity: 0.45;
      transform: translate(-50%, -50%) scale(0.96);
    }
    50% {
      opacity: 0.85;
      transform: translate(-50%, -50%) scale(1.08);
    }
  }

  @media (max-width: 768px) {
    .tsc-track {
      gap: 0.85rem;
    }

    .tsc-track-left {
      animation-duration: 42s;
    }

    .tsc-track-right {
      animation-duration: 46s;
    }

    .tsc-logo {
      width: 50px;
      height: 50px;
      min-width: 50px;
      max-width: 50px;
      min-height: 50px;
      max-height: 50px;
      border-radius: 0.95rem;
    }

    .tsc-icon {
      width: 23px;
      height: 23px;
      min-width: 23px;
      max-width: 23px;
      min-height: 23px;
      max-height: 23px;
    }

    .tsc-fade::before,
    .tsc-fade::after {
      width: 18%;
    }
  }
</style>

<script define:vars={{ locale }}>
  const label = document.getElementById(`tech-active-label-${locale}`);
  const items = document.querySelectorAll(`.tsc-logo[data-locale="${locale}"]`);

  items.forEach((item) => {
    item.addEventListener('mouseenter', () => {
      if (!label) return;
      label.textContent = item.getAttribute('data-label') || '';
      label.classList.add('is-active');
    });

    item.addEventListener('mouseleave', () => {
      if (!label) return;
      label.textContent = locale === 'es' ? 'Pasa el cursor sobre un logo' : 'Hover a logo';
      label.classList.remove('is-active');
    });
  });
</script>
  </main>
</Layout>

<script>
  const orcidID = "0009-0006-5247-3629"; 
  const container = document.getElementById('orcid-publications');

  async function fetchOrcidWorks() {
    try {
      const response = await fetch(`https://pub.orcid.org/v3.0/${orcidID}/works`, {
        headers: { 'Accept': 'application/json' }
      });
      
      if (!response.ok) throw new Error('Error al conectar con ORCID');
      
      const data = await response.json();
      const works = data.group;

      container.innerHTML = ''; 

      if (works.length === 0) {
        container.innerHTML = `<p class="text-slate-400">Las publicaciones se están indexando o actualizando en ORCID.</p>`;
        return;
      }

      works.forEach(workGroup => {
        const workSummary = workGroup['work-summary'][0];
        const title = workSummary.title.title.value;
        
        // Evitar duplicar el artículo de la IEEE que ya está fijo arriba
        if (title.includes("Smart Air Quality")) return;

        const year = workSummary['publication-date'] ? workSummary['publication-date'].year.value : 'Año N/D';
        const type = workSummary.type.replace('_', ' ').toUpperCase();
        
        let link = '#';
        if (workSummary.url && workSummary.url.value) {
            link = workSummary.url.value;
        } else if (workSummary['external-ids'] && workSummary['external-ids']['external-id'].length > 0) {
            const externalId = workSummary['external-ids']['external-id'][0];
            if (externalId['external-id-url']) {
                link = externalId['external-id-url'].value;
            }
        }

        const articleHTML = `
          <div class="p-5 rounded-xl border border-slate-800 bg-slate-900/40 hover:bg-slate-800/50 transition-colors group flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-3 mb-1">
                <span class="px-2 py-0.5 text-[10px] font-bold tracking-wider rounded bg-green-500/10 text-green-400 border border-green-500/20">${type}</span>
                <span class="text-sm font-mono text-slate-500">${year}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-200 group-hover:text-cyan-400 transition-colors">${title}</h3>
            </div>
            ${link !== '#' ? `
              <a href="${link}" target="_blank" class="shrink-0 px-4 py-2 text-sm font-medium rounded-lg border border-slate-700 hover:border-cyan-500 text-slate-300 hover:text-cyan-400 transition-colors flex items-center gap-2">
                Leer original 
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </a>
            ` : ''}
          </div>
        `;
        
        container.innerHTML += articleHTML;
      });

    } catch (error) {
      console.error(error);
      container.innerHTML = `<p class="text-red-400">Hubo un problema al cargar los artículos. Por favor, revisa mi perfil directamente.</p>`;
    }
  }

  document.addEventListener('DOMContentLoaded', fetchOrcidWorks);
</script>
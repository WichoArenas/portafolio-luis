    100% { transform: translateY(100%); }
  }
</style>

<script>
  /* 1. SCRIPT DE ORCID */
  const orcidID = "0009-0006-5247-3629"; 
  const container = document.getElementById('orcid-publications');

  async function fetchOrcidWorks() {
    try {
      const response = await fetch(`https://pub.orcid.org/v3.0/${orcidID}/works`, { headers: { 'Accept': 'application/json' }});
      if (!response.ok) throw new Error('Error al conectar con ORCID');
      const data = await response.json();
      const works = data.group;
      container.innerHTML = ''; 

      if (works.length === 0) return container.innerHTML = `<p class="text-slate-400">Las publicaciones se están indexando en ORCID.</p>`;

      works.forEach(workGroup => {
        const summary = workGroup['work-summary'][0];
        const title = summary.title.title.value;
        if (title.includes("Smart Air Quality")) return; // Omite duplicado IEEE
        
        const year = summary['publication-date'] ? summary['publication-date'].year.value : 'N/D';
        const type = summary.type.replace('_', ' ').toUpperCase();
        let link = '#';
        if (summary.url && summary.url.value) link = summary.url.value;

        container.innerHTML += `
          <div class="p-5 rounded-xl border border-slate-800 bg-slate-900/40 hover:bg-slate-800/50 transition-colors flex justify-between gap-4">
            <div>
              <div class="flex items-center gap-3 mb-1"><span class="px-2 text-[10px] rounded bg-green-500/10 text-green-400 border border-green-500/20">${type}</span><span class="text-sm font-mono text-slate-500">${year}</span></div>
              <h3 class="text-lg font-bold text-slate-200">${title}</h3>
            </div>
            ${link !== '#' ? `<a href="${link}" target="_blank" class="shrink-0 px-4 py-2 text-sm rounded border border-slate-700 hover:border-cyan-500 text-slate-300">Leer &rarr;</a>` : ''}
          </div>`;
      });
    } catch (e) { container.innerHTML = `<p class="text-red-400">Error al cargar publicaciones dinámicas.</p>`; }
  }
  document.addEventListener('DOMContentLoaded', fetchOrcidWorks);

  /* 2. SCRIPT DE TERMINAL DINÁMICA (PERFIL) */
  const skills = [
    "Especialista en IA y Visión Computacional.",
    "Desarrollo de Algoritmos Satelitales.",
    "Ingeniería de Firmware a 1 MHz.",
    "Optimización de Modelos de Negocio.",
    "Sistemas Autónomos (Transport Canada Cert)."
  ];
  let skillIndex = 0; let charIndex = 0; let isDeleting = false;
  const typeTarget = document.getElementById('typewriter');
  
  function typeEffect() {
    const currentSkill = skills[skillIndex];
    if (isDeleting) {
      typeTarget.innerText = currentSkill.substring(0, charIndex - 1);
      charIndex--;
    } else {
      typeTarget.innerText = currentSkill.substring(0, charIndex + 1);
      charIndex++;
    }

    let speed = isDeleting ? 30 : 70;
    if (!isDeleting && charIndex === currentSkill.length) { speed = 2000; isDeleting = true; } 
    else if (isDeleting && charIndex === 0) { isDeleting = false; skillIndex = (skillIndex + 1) % skills.length; speed = 500; }
    setTimeout(typeEffect, speed);
  }
  setTimeout(typeEffect, 1000);

  /* 3. SCRIPT DEL FONDO DE RED NEURONAL / ALGORITMO */
  const canvas = document.getElementById('neural-bg');
  const ctx = canvas.getContext('2d');
  canvas.width = window.innerWidth; canvas.height = window.innerHeight;
  let particles = [];
  
  class Particle {
    constructor() {
      this.x = Math.random() * canvas.width; this.y = Math.random() * canvas.height;
      this.vx = (Math.random() - 0.5) * 0.5; this.vy = (Math.random() - 0.5) * 0.5;
      this.radius = Math.random() * 2;
    }
    update() {
      this.x += this.vx; this.y += this.vy;
      if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
      if (this.y < 0 || this.y > canvas.height) this.vy *= -1;
    }
    draw() {
      ctx.beginPath(); ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
      ctx.fillStyle = '#06b6d4'; ctx.fill();
    }
  }
  
  for(let i=0; i<70; i++) particles.push(new Particle());

  function animateCanvas() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for(let i=0; i<particles.length; i++) {
      particles[i].update(); particles[i].draw();
      for(let j=i; j<particles.length; j++) {
        const dx = particles[i].x - particles[j].x; const dy = particles[i].y - particles[j].y;
        const dist = Math.sqrt(dx*dx + dy*dy);
        if (dist < 150) {
          ctx.beginPath(); ctx.strokeStyle = `rgba(6, 182, 212, ${1 - dist/150})`;
          ctx.lineWidth = 0.5; ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y); ctx.stroke();
        }
      }
    }
    requestAnimationFrame(animateCanvas);
  }
  animateCanvas();
  window.addEventListener('resize', () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; });
</script>
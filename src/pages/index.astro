---
import Layout from '../layouts/Layout.astro';
import certifications from '../data/certifications.json';
import PortfolioContact from '../components/PortfolioContact.astro';
import NeuralResearchBackground from '../components/NeuralResearchBackground.astro';

const featuredCertifications = certifications.filter((cert) => cert.featured);
---

<Layout>

  

  <nav class="max-w-6xl mx-auto px-6 py-8 flex flex-wrap gap-4 justify-between items-center relative z-10">
    <a href="/portafolio-luis/" class="text-sm font-bold tracking-[0.25em] text-slate-200 hover:text-cyan-300 transition-colors">
      LUIS_ARENAS<span class="text-cyan-400">.DEV</span>
    </a>

    <div class="flex flex-wrap gap-3 items-center text-sm">
      <a href="#research" class="text-slate-400 hover:text-cyan-300 transition-colors">Investigación</a>
      <a href="#highlight" class="text-slate-400 hover:text-cyan-300 transition-colors">Artículo clave</a>
      <a href="#projects" class="text-slate-400 hover:text-cyan-300 transition-colors">Proyectos</a>
      <a href="#credentials" class="text-slate-400 hover:text-cyan-300 transition-colors">Certificaciones</a>
      <a href="#publications" class="text-slate-400 hover:text-cyan-300 transition-colors">Publicaciones</a>
      <a href="#contact" class="text-slate-400 hover:text-cyan-300 transition-colors">Contacto</a>
      <a href="/portafolio-luis/en/" class="ml-2 text-xs font-semibold text-slate-300 hover:text-white border border-slate-700 px-3 py-1.5 rounded-md transition-colors">
        EN / ES
      </a>
    </div>
  </nav>

  <main class="max-w-6xl mx-auto px-6 py-10 relative z-10">
    <header class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-10 items-center">
      <section class="space-y-6">
        <div class="flex flex-wrap gap-3">
          <span class="inline-flex px-3 py-1 rounded-full border border-blue-500/30 bg-blue-500/10 text-blue-300 text-sm font-medium tracking-wide">
            Estancia de investigación en Canadá
          </span>
          <span class="inline-flex px-3 py-1 rounded-full border border-purple-500/30 bg-purple-500/10 text-purple-300 text-sm font-medium tracking-wide">
            Consultoría y charlas técnicas disponibles
          </span>
          <span class="inline-flex px-3 py-1 rounded-full border border-cyan-500/30 bg-cyan-500/10 text-cyan-300 text-sm font-medium tracking-wide">
            IA · Visión · Inteligencia embebida
          </span>
        </div>

        <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-white">
          Hola, soy <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-500">Luis Arenas</span>
        </h1>

        <p class="text-xl md:text-2xl text-slate-400 max-w-4xl leading-relaxed">
          Investigador doctoral y desarrollador tecnológico trabajando en la intersección de
          <strong class="text-slate-100">visión computacional</strong>,
          <strong class="text-slate-100">inteligencia artificial</strong>,
          <strong class="text-slate-100">reconocimiento multimodal de emociones</strong>,
          <strong class="text-slate-100">sensado inteligente</strong>, and
          <strong class="text-slate-100">sistemas embebidos en tiempo real</strong>.
        </p>

        <p class="text-base text-slate-500 max-w-3xl leading-relaxed">
          Construyo sistemas inteligentes que conectan investigación, hardware, plataformas digitales y estrategia empresarial, transformando modelos técnicos en herramientas prácticas para escenarios académicos, empresariales e institucionales.
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <a href="#publications" class="px-5 py-3 rounded-xl bg-cyan-500 text-slate-950 font-bold hover:bg-cyan-300 transition-all shadow-[0_0_25px_rgba(6,182,212,0.25)]">
            Ver publicaciones
          </a>
          <a href="#projects" class="px-5 py-3 rounded-xl border border-slate-700 text-slate-200 hover:border-cyan-400 hover:text-cyan-300 transition-all">
            Explorar proyectos
          </a>
          <a href="https://orcid.org/0009-0006-5247-3629" target="_blank" rel="noopener noreferrer" class="px-5 py-3 rounded-xl border border-green-500/40 text-green-300 hover:bg-green-500/10 transition-all">
            Perfil ORCID
          </a>
        </div>
      </section>

      <aside class="rounded-2xl border border-green-500/30 bg-black/75 p-5 font-mono text-sm shadow-[0_0_35px_rgba(34,197,94,0.10)] relative overflow-hidden">
        <div class="absolute inset-0 opacity-10 pointer-events-none terminal-grid"></div>
        <div class="relative z-10">
          <div class="flex items-center gap-2 mb-4">
            <span class="w-3 h-3 rounded-full bg-red-400"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
            <span class="w-3 h-3 rounded-full bg-green-400"></span>
            <span class="ml-2 text-slate-500">terminal-investigación</span>
          </div>

          <p><span class="text-slate-500">luis@portfolio:~$</span> ./scan_profile --public</p>
          <p class="text-cyan-400 mt-2">&gt; Cargando identidad de investigación...</p>
          <p class="text-green-400">&gt; Construyendo capa dinámica de publicaciones...</p>
          <p class="text-purple-300">&gt; Verificando metadatos ORCID + DOI...</p>
          <p class="text-slate-300 mt-4"><span id="typewriter" class="font-bold text-white"></span><span class="animate-pulse">_</span></p>

          <div class="mt-5 rounded-xl border border-slate-800 bg-slate-950/70 p-4">
            <p class="text-slate-500 mb-2">live_status.log</p>
            <p id="terminal-status" class="text-cyan-300">Inicializando perfil científico...</p>
          </div>

          <div class="mt-5 grid grid-cols-2 gap-3 text-xs">
            <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/5 p-3">
              <p class="text-slate-500 uppercase tracking-widest">Modo</p>
              <p class="text-cyan-300 font-bold mt-1">Académico + Empresarial</p>
            </div>
            <div class="rounded-xl border border-purple-500/20 bg-purple-500/5 p-3">
              <p class="text-slate-500 uppercase tracking-widest">Nodo</p>
              <p class="text-purple-300 font-bold mt-1">INAOE + UBCO</p>
            </div>
          </div>
        </div>
      </aside>
    </header>

    <section id="research" class="mt-24">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-800 pb-4 mb-10">
        <div>
          <p class="text-xs font-bold text-cyan-400 uppercase tracking-[0.3em] mb-2">Identidad de investigación</p>
          <h2 class="text-3xl font-bold text-white">Consola de investigación e innovación</h2>
        </div>
        <p class="text-slate-500 max-w-2xl">
          Un perfil académico vivo: áreas de investigación, proyectos, publicaciones, señales de citas y enlaces originales en un solo lugar.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr] gap-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 hover:border-cyan-500/50 transition-all">
            <p class="text-cyan-400 font-mono text-sm mb-3">01</p>
            <h3 class="text-xl font-bold text-white mb-2">Reconocimiento de emociones sensible al contexto</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Fusión contextual de estilo bayesiano, priors de escena, suavizado temporal y análisis facial de emociones en tiempo real.</p>
          </article>

          <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 hover:border-blue-500/50 transition-all">
            <p class="text-blue-400 font-mono text-sm mb-3">02</p>
            <h3 class="text-xl font-bold text-white mb-2">Transformers multimodales</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Fusión imagen/audio, atención cruzada, inferencia consciente del hardware y pipelines experimentales para reconocimiento de emociones.</p>
          </article>

          <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 hover:border-purple-500/50 transition-all">
            <p class="text-purple-400 font-mono text-sm mb-3">03</p>
            <h3 class="text-xl font-bold text-white mb-2">IA embebida y sensado inteligente</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Monitoreo IoT, microcontroladores, dispositivos edge, tableros en la nube y despliegue en tiempo real.</p>
          </article>

          <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 hover:border-emerald-500/50 transition-all">
            <p class="text-emerald-400 font-mono text-sm mb-3">04</p>
            <h3 class="text-xl font-bold text-white mb-2">Estrategia de IA orientada a negocio</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Plataformas digitales y flujos de IA alineados con eficiencia operativa, misión y objetivos institucionales de largo plazo.</p>
          </article>
        </div>

        <article class="rounded-2xl border border-cyan-500/20 bg-slate-950/70 p-6 relative overflow-hidden min-h-[330px]">
          <div class="absolute inset-0 opacity-25 pointer-events-none algorithm-field"></div>
          <div class="relative z-10">
            <p class="text-xs font-bold text-cyan-400 uppercase tracking-[0.3em] mb-3">Núcleo dinámico del perfil</p>
            <h3 class="text-2xl font-bold text-white mb-4">Características principales del perfil</h3>
            <div id="profile-feature-board" class="space-y-3">
              <div class="rounded-xl border border-slate-800 bg-black/40 p-4">
                <p class="text-slate-500 text-xs uppercase tracking-widest">Capacidad central</p>
                <p class="text-cyan-300 font-mono mt-1">Investigador en visión computacional</p>
              </div>
              <div class="rounded-xl border border-slate-800 bg-black/40 p-4">
                <p class="text-slate-500 text-xs uppercase tracking-widest">Dirección aplicada</p>
                <p class="text-purple-300 font-mono mt-1">IA + Hardware + Estrategia</p>
              </div>
              <div class="rounded-xl border border-slate-800 bg-black/40 p-4">
                <p class="text-slate-500 text-xs uppercase tracking-widest">Enfoque actual</p>
                <p id="live-focus" class="text-green-300 font-mono mt-1">Inteligencia multimodal sensible al contexto</p>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>


    <section id="highlight" class="mt-24">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 border-b border-slate-800 pb-4 mb-10">
        <div>
          <p class="text-xs font-bold text-purple-400 uppercase tracking-[0.3em] mb-2">Artículo destacado</p>
          <h2 class="text-3xl font-bold text-white">A Probabilistic Framework for Reconocimiento facial de emociones con contexto de escena</h2>
        </div>
        <p class="text-slate-500 max-w-2xl">
          Un marco dual en tiempo real que integra el contexto de escena como prior probabilístico explícito para el reconocimiento facial de emociones.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[0.95fr_1.05fr] gap-8">
        <article class="rounded-3xl border border-purple-500/25 bg-gradient-to-br from-purple-500/10 via-slate-950/80 to-cyan-500/10 p-6 relative overflow-hidden">
          <div class="absolute inset-0 opacity-25 pointer-events-none research-orbit"></div>
          <div class="relative z-10">
            <div class="flex flex-wrap gap-2 mb-5">
              <span class="pub-badge bg-purple-500/20 text-purple-300 border-purple-500/30">ACEPTADO · EN PRODUCCIÓN</span>
              <span class="pub-badge bg-cyan-500/10 text-cyan-300 border-cyan-500/30">EDGE-READY AI</span>
              <span class="pub-badge bg-green-500/10 text-green-300 border-green-500/30">BCPF FUSION</span>
            </div>

            <h3 class="text-2xl font-bold text-white mb-4">El contexto como prior probabilístico</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">
              El marco combina una rama de emoción facial con una rama de contexto de escena. La rama contextual estima siete entornos sociales y usa el posterior resultante como prior para reponderar las probabilidades emocionales, reduciendo asignaciones emoción-contexto poco plausibles y preservando el comportamiento en tiempo real.
            </p>

            <div class="grid grid-cols-2 gap-3 mb-6">
              <div class="metric-chip">
                <p class="metric-value">7</p>
                <p class="metric-label">Contextos de escena</p>
              </div>
              <div class="metric-chip">
                <p class="metric-value">6</p>
                <p class="metric-label">Clases emocionales</p>
              </div>
              <div class="metric-chip">
                <p class="metric-value">30+</p>
                <p class="metric-label">Objetivo FPS</p>
              </div>
              <div class="metric-chip">
                <p class="metric-value">PSC</p>
                <p class="metric-label">IDC · ISR · VSC</p>
              </div>
            </div>

            <div class="flex flex-wrap gap-2">
              <span class="tag">Segmentación YOLO</span>
              <span class="tag">MobileNetV2</span>
              <span class="tag">Suavizado temporal</span>
              <span class="tag">Fusión contextual bayesiana</span>
              <span class="tag">Jetson / Raspberry Pi</span>
            </div>
          </div>
        </article>

        <article class="rounded-3xl border border-slate-800 bg-slate-950/80 p-6 relative overflow-hidden">
          <div class="absolute inset-0 opacity-20 pointer-events-none algorithm-field"></div>
          <div class="relative z-10">
            <p class="text-xs font-bold text-cyan-400 uppercase tracking-[0.3em] mb-4">Concepto visual de fusión</p>
            <div class="space-y-4">
              <div class="pipeline-node border-cyan-500/30">
                <span class="node-index text-cyan-300">01</span>
                <div>
                  <h4 class="node-title">Rama facial</h4>
                  <p class="node-text">Una CNN ligera estima un posterior facial de seis emociones.</p>
                </div>
              </div>
              <div class="pipeline-node border-purple-500/30">
                <span class="node-index text-purple-300">02</span>
                <div>
                  <h4 class="node-title">Rama de escena</h4>
                  <p class="node-text">Enmascaramiento con YOLO y MobileNetV2 clasifican el contexto social.</p>
                </div>
              </div>
              <div class="pipeline-node border-green-500/30">
                <span class="node-index text-green-300">03</span>
                <div>
                  <h4 class="node-title">Matriz de prior contextual</h4>
                  <p class="node-text">Pctx convierte la probabilidad de escena en un prior de compatibilidad afectiva.</p>
                </div>
              </div>
              <div class="pipeline-node border-blue-500/30">
                <span class="node-index text-blue-300">04</span>
                <div>
                  <h4 class="node-title">Salida BCPF</h4>
                  <p class="node-text">Una compuerta de confianza evita sobrecorrecciones cuando el contexto es incierto.</p>
                </div>
              </div>
            </div>

            <div class="mt-6 rounded-2xl border border-slate-800 bg-black/50 p-4">
              <div class="flex justify-between text-xs text-slate-500 mb-2"><span>Ambigüedad solo facial</span><span>Confianza fusionada</span></div>
              <div class="fusion-track"><span class="fusion-bar face-bar"></span></div>
              <div class="fusion-track mt-3"><span class="fusion-bar context-bar"></span></div>
              <div class="fusion-track mt-3"><span class="fusion-bar output-bar"></span></div>
              <div class="grid grid-cols-3 gap-2 mt-3 text-[10px] uppercase tracking-widest text-slate-500">
                <span>Rostro</span><span>Contexto</span><span>Salida</span>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="mt-24 grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-2xl font-bold text-white mb-8 border-b border-slate-800 pb-3">Experiencia y estrategia</h2>
        <div class="space-y-8">
          <div class="relative pl-4 border-l border-slate-800 hover:border-cyan-500/50 transition-colors">
            <span class="text-xs font-mono text-cyan-400">2026 - Present</span>
            <h3 class="text-lg font-bold text-slate-200 mt-1">Investigador visitante</h3>
            <p class="text-sm text-slate-400 font-medium">University of British Columbia Okanagan</p>
            <p class="text-slate-400 text-sm mt-2 leading-relaxed">Estancia internacional de investigación enfocada en IA, sistemas autónomos, sensado e integración hardware/software en tiempo real.</p>
          </div>
          <div class="relative pl-4 border-l border-slate-800 hover:border-purple-500/50 transition-colors">
            <span class="text-xs font-mono text-purple-400">2023 - Present</span>
            <h3 class="text-lg font-bold text-slate-200 mt-1">Profesor universitario y consultor tecnológico</h3>
            <p class="text-sm text-slate-400 font-medium">Docencia, tecnología aplicada y estrategia digital</p>
            <p class="text-slate-400 text-sm mt-2 leading-relaxed">Diseño de cursos técnicos y asesoría en soluciones tecnológicas para mejorar la eficiencia operativa mediante IA, plataformas digitales y automatización.</p>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-white mb-8 border-b border-slate-800 pb-3">Formación académica</h2>
        <div class="space-y-8">
          <div class="relative pl-4 border-l border-slate-800 hover:border-blue-500/50 transition-colors">
            <span class="text-xs font-mono text-blue-400">En curso · Estimado dic. 2027</span>
            <h3 class="text-lg font-bold text-slate-200 mt-1">Doctorado en Ciencias de la Electrónica</h3>
            <p class="text-sm text-slate-400 font-medium">INAOE</p>
          </div>
          <div class="relative pl-4 border-l border-slate-800 hover:border-blue-500/50 transition-colors">
            <span class="text-xs font-mono text-slate-500">Concluido</span>
            <h3 class="text-lg font-bold text-slate-200 mt-1">Maestría en Ciencias de la Electrónica</h3>
            <p class="text-sm text-slate-400 font-medium">INAOE</p>
          </div>
          <div class="relative pl-4 border-l border-slate-800 hover:border-blue-500/50 transition-colors">
            <span class="text-xs font-mono text-slate-500">Concluido</span>
            <h3 class="text-lg font-bold text-slate-200 mt-1">Licenciatura en Ingeniería Mecatrónica</h3>
            <p class="text-sm text-slate-400 font-medium">Universidad Iberoamericana Puebla</p>
          </div>
          <div class="relative pl-4 border-l border-slate-800 hover:border-blue-500/50 transition-colors">
            <span class="text-xs font-mono text-slate-500">Concluido</span>
            <h3 class="text-lg font-bold text-slate-200 mt-1">Licenciatura en Ingeniería en Comunicaciones y Electrónica</h3>
            <p class="text-sm text-slate-400 font-medium">Universidad Iberoamericana Puebla</p>
          </div>
        </div>
      </div>
    </section>

    <section id="projects" class="mt-24">
      <div class="border-b border-slate-800 pb-4 mb-10">
        <p class="text-xs font-bold text-cyan-400 uppercase tracking-[0.3em] mb-2">Sistemas desarrollados</p>
        <h2 class="text-3xl font-bold text-white">Desarrollo tecnológico y proyectos</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <article class="group rounded-2xl border border-slate-800 bg-slate-900/50 overflow-hidden hover:border-cyan-500/50 transition-all flex flex-col md:col-span-2">
          <div class="h-72 w-full bg-slate-900 relative flex justify-center items-center overflow-hidden">
            <span class="absolute z-10 text-slate-500 font-mono text-sm">Upload: /public/satellite.jpg</span>
            <img src="/portafolio-luis/satellite.jpg" alt="Satellite scan model preview" class="absolute inset-0 w-full h-full object-cover z-20 grayscale group-hover:grayscale-0 transition-all duration-500 opacity-0 hover:opacity-100" onload="this.classList.remove('opacity-0'); this.previousElementSibling.style.display='none';" />
            <div class="absolute inset-0 z-30 bg-gradient-to-b from-transparent via-cyan-500/25 to-transparent animate-[scan_3.2s_ease-in-out_infinite] pointer-events-none"></div>
            <div class="absolute inset-0 z-30 satellite-grid pointer-events-none"></div>
          </div>
          <div class="p-6">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <h3 class="text-2xl font-bold text-white">Escaneo satelital en tiempo real</h3>
              <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded bg-red-500/20 text-red-300 border border-red-500/30">Nivel gubernamental y académico</span>
            </div>
            <p class="text-slate-400 text-sm mb-4 max-w-4xl leading-relaxed">Desarrollo de algoritmos de procesamiento de imágenes satelitales en tiempo real para inteligencia territorial, monitoreo ambiental, análisis orientado a seguridad y aplicaciones académicas/gubernamentales.</p>
            <div class="flex gap-2 flex-wrap">
              <span class="tag">Algoritmos de escaneo</span>
              <span class="tag">Percepción remota</span>
              <span class="tag">Procesamiento en tiempo real</span>
              <span class="tag">Inteligencia territorial</span>
            </div>
          </div>
        </article>

        <article class="group rounded-2xl border border-slate-800 bg-slate-900/50 overflow-hidden hover:border-yellow-500/50 transition-all flex flex-col">
          <div class="h-56 w-full bg-slate-900 relative overflow-hidden drone-radar">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(168,85,247,0.20),transparent_40%)]"></div>
            <div class="absolute inset-0 drone-grid"></div>
            <div class="drone-path"><span class="drone-dot">✦</span></div>
            <video
  class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-75 transition-opacity duration-500"
  autoplay
  muted
  loop
  playsinline
  preload="auto"
  poster="/portafolio-luis/drone.jpg"
>
  <source src="/portafolio-luis/drone-demo.mp4?v=99" type="video/mp4" />
</video>
            <div class="absolute bottom-4 left-4 right-4 z-20 text-xs font-mono text-purple-200/80">tracking.init(target='aerial_object', mode='research')</div>
          </div>
          <div class="p-6 flex-grow flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <h3 class="text-xl font-bold text-white">Sistemas aéreos y drones autónomos</h3>
                <span class="px-2 py-0.5 text-[10px] font-bold uppercase rounded bg-purple-500/20 text-purple-300 border border-purple-500/30">Académico + Empresarial</span>
              </div>
              <p class="text-slate-400 text-sm mb-4 leading-relaxed">Operación de drones autónomos, lógica de navegación, seguimiento en tiempo real y pipelines de control con visión computacional para investigación, pruebas de campo y sistemas aéreos orientados a empresas.</p>
            </div>
            <div class="flex gap-2 flex-wrap">
              <span class="tag">Navegación autónoma</span>
              <span class="tag">Control GCS</span>
              <span class="tag">Seguimiento en tiempo real</span>
            </div>

        <p class="text-slate-500 animate-pulse">Consultando la base de datos de ORCID...</p>
      </div>
      
      <div class="mt-8 flex gap-4">
         <a href="https://ieeexplore.ieee.org/author/395576129474048" target="_blank" class="text-sm text-blue-400 hover:text-blue-300 transition-colors flex items-center gap-1">
            Perfil de Autor IEEE &rarr;
         </a>
         <a href="https://orcid.org/0009-0006-5247-3629" target="_blank" class="text-sm text-cyan-400 hover:text-cyan-300 transition-colors flex items-center gap-1">

  .pcb-visual {
    background:
      radial-gradient(circle at 30% 45%, rgba(16,185,129,0.15), transparent 20%),
      radial-gradient(circle at 70% 55%, rgba(6,182,212,0.12), transparent 24%),
      #020617;
  }

  .pcb-board {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(90deg, transparent 0 12%, rgba(16,185,129,0.55) 12% 13%, transparent 13% 100%),
      linear-gradient(0deg, transparent 0 24%, rgba(16,185,129,0.45) 24% 25%, transparent 25% 100%),
      linear-gradient(90deg, transparent 0 64%, rgba(6,182,212,0.45) 64% 65%, transparent 65% 100%),
      linear-gradient(0deg, transparent 0 67%, rgba(6,182,212,0.45) 67% 68%, transparent 68% 100%);
    background-size: 110px 110px, 130px 130px, 95px 95px, 150px 150px;
    animation: pcbShift 6s linear infinite;
  }

  .pcb-board::before {
    content: "";
    position: absolute;
    inset: 20%;
    border: 1px solid rgba(16,185,129,0.55);
    border-radius: 14px;
    box-shadow: 0 0 24px rgba(16,185,129,0.2), inset 0 0 30px rgba(16,185,129,0.06);
  }

  .pcb-board::after {
    content: "";
    position: absolute;
    left: -30%;
    top: 0;
    width: 30%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(16,185,129,0.35), transparent);
    animation: pcbScan 3.5s ease-in-out infinite;
  }

  @keyframes pcbShift {
    from { background-position: 0 0, 0 0, 0 0, 0 0; }
    to { background-position: 110px 110px, -130px 130px, 95px -95px, -150px -150px; }
  }

  @keyframes pcbScan {
    from { left: -30%; }
    to { left: 100%; }
  }

  .metric-chip {
    border: 1px solid rgba(51, 65, 85, 0.7);
    border-radius: 1rem;
    background: rgba(2, 6, 23, 0.55);
    padding: 1rem;
  }

  .metric-value {
    font-size: 1.6rem;
    line-height: 2rem;
    font-weight: 800;
    color: rgb(103, 232, 249);
  }

  .metric-label {
    margin-top: 0.25rem;
    font-size: 0.68rem;

    background-image: linear-gradient(115deg, transparent 0%, rgba(6,182,212,0.2) 48%, transparent 52%), linear-gradient(65deg, transparent 0%, rgba(16,185,129,0.16) 48%, transparent 52%);
    background-size: 140px 140px;

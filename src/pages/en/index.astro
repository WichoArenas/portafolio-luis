  }

  .drone-grid {
    position: absolute;
    inset: 0;
    opacity: 0.2;
    background-image: linear-gradient(rgba(168,85,247,0.35) 1px, transparent 1px), linear-gradient(90deg, rgba(168,85,247,0.35) 1px, transparent 1px);
    background-size: 34px 34px;

---
import Layout from '../../layouts/Layout.astro';
import certifications from '../../data/certifications.json';
import PortfolioContact from '../../components/PortfolioContact.astro';
import NeuralResearchBackground from '../../components/NeuralResearchBackground.astro';
import TechStackCarousel from '../../components/TechStackCarousel.astro';
import LogoMark from '../../components/LogoMark.astro';

const featuredCertifications = certifications.filter((cert) => cert.featured);
---

<Layout>
   

 
  <nav class="max-w-6xl mx-auto px-6 py-8 flex flex-wrap gap-4 justify-between items-center relative z-10">
    <LogoMark label="LUIS_ARENAS.DEV" />

    <div class="flex flex-wrap gap-3 items-center text-sm">
      <a href="#research" class="text-slate-400 hover:text-cyan-300 transition-colors">Research</a>
      <a href="#highlight" class="text-slate-400 hover:text-cyan-300 transition-colors">Highlight</a>
      <a href="#projects" class="text-slate-400 hover:text-cyan-300 transition-colors">Projects</a>
      <a href="#credentials" class="text-slate-400 hover:text-cyan-300 transition-colors">Credentials</a>
      <a href="#publications" class="text-slate-400 hover:text-cyan-300 transition-colors">Publications</a>
      <a href="#contact" class="text-slate-400 hover:text-cyan-300 transition-colors">Contact</a>
      <a href="/portafolio-luis/" class="ml-2 text-xs font-semibold text-slate-300 hover:text-white border border-slate-700 px-3 py-1.5 rounded-md transition-colors">
        ES / EN
      </a>
    </div>
  </nav>

  <main class="max-w-6xl mx-auto px-6 py-10 relative z-10">
    <header class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-10 items-center">
      <section class="space-y-6">
        <div class="flex flex-wrap gap-3">
          <span class="inline-flex px-3 py-1 rounded-full border border-blue-500/30 bg-blue-500/10 text-blue-300 text-sm font-medium tracking-wide">
            Research Stay in Canada
          </span>
          <span class="inline-flex px-3 py-1 rounded-full border border-purple-500/30 bg-purple-500/10 text-purple-300 text-sm font-medium tracking-wide">
            Consulting & Technical Talks Available
          </span>
          <span class="inline-flex px-3 py-1 rounded-full border border-cyan-500/30 bg-cyan-500/10 text-cyan-300 text-sm font-medium tracking-wide">
            AI · Vision · Embedded Intelligence
          </span>
        </div>

        <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-white">
          Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-500">Luis Arenas</span>
        </h1>

        <p class="text-xl md:text-2xl text-slate-400 max-w-4xl leading-relaxed">
          PhD researcher and technology developer working at the intersection of
          <strong class="text-slate-100">computer vision</strong>,
          <strong class="text-slate-100">artificial intelligence</strong>,
          <strong class="text-slate-100">multimodal emotion recognition</strong>,
          <strong class="text-slate-100">smart sensing</strong>, and
          <strong class="text-slate-100">real-time embedded systems</strong>.
        </p>

        <p class="text-base text-slate-500 max-w-3xl leading-relaxed">
          I build intelligent systems that connect research, hardware, digital platforms, and business strategy — turning technical models into practical tools for academic, enterprise, and institutional scenarios.
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <a href="#publications" class="px-5 py-3 rounded-xl bg-cyan-500 text-slate-950 font-bold hover:bg-cyan-300 transition-all shadow-[0_0_25px_rgba(6,182,212,0.25)]">
            View Publications
          </a>
          <a href="#projects" class="px-5 py-3 rounded-xl border border-slate-700 text-slate-200 hover:border-cyan-400 hover:text-cyan-300 transition-all">
            Explore Projects
          </a>
          <a href="https://orcid.org/0009-0006-5247-3629" target="_blank" rel="noopener noreferrer" class="px-5 py-3 rounded-xl border border-green-500/40 text-green-300 hover:bg-green-500/10 transition-all">
            ORCID Profile
          </a>
        </div>
      </section>

      <aside class="rounded-2xl border border-green-500/30 bg-black/75 p-5 font-mono text-sm shadow-[0_0_35px_rgba(34,197,94,0.10)] relative overflow-hidden">
        <div class="absolute inset-0 opacity-10 pointer-events-none terminal-grid"></div>
        <div class="relative z-10">
          <div class="flex items-center gap-2 mb-4">
            <span class="w-3 h-3 rounded-full bg-red-400"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
            <span class="w-3 h-3 rounded-full bg-green-400"></span>
            <span class="ml-2 text-slate-500">research-terminal</span>
          </div>

          <p><span class="text-slate-500">luis@portfolio:~$</span> ./scan_profile --public</p>
          <p class="text-cyan-400 mt-2">&gt; Loading research identity...</p>
          <p class="text-green-400">&gt; Building dynamic publication layer...</p>
          <p class="text-purple-300">&gt; Checking ORCID + DOI metadata...</p>
          <p class="text-slate-300 mt-4"><span id="typewriter" class="font-bold text-white"></span><span class="animate-pulse">_</span></p>

          <div class="mt-5 rounded-xl border border-slate-800 bg-slate-950/70 p-4">
            <p class="text-slate-500 mb-2">live_status.log</p>
            <p id="terminal-status" class="text-cyan-300">Initializing scientific profile...</p>
          </div>

          <div class="mt-5 grid grid-cols-2 gap-3 text-xs">
            <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/5 p-3">
              <p class="text-slate-500 uppercase tracking-widest">Mode</p>
              <p class="text-cyan-300 font-bold mt-1">Academic + Enterprise</p>
            </div>
            <div class="rounded-xl border border-purple-500/20 bg-purple-500/5 p-3">
              <p class="text-slate-500 uppercase tracking-widest">Node</p>
              <p class="text-purple-300 font-bold mt-1">INAOE + UBCO</p>
            </div>
          </div>
        </div>
      </aside>
    </header>

    <section id="research" class="mt-24">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-slate-800 pb-4 mb-10">
        <div>
          <p class="text-xs font-bold text-cyan-400 uppercase tracking-[0.3em] mb-2">Research Identity</p>
          <h2 class="text-3xl font-bold text-white">Research & Innovation Console</h2>
        </div>
        <p class="text-slate-500 max-w-2xl">
          A living academic profile: research areas, projects, publication records, citation signals, and original external links in one place.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr] gap-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 hover:border-cyan-500/50 transition-all">
            <p class="text-cyan-400 font-mono text-sm mb-3">01</p>
            <h3 class="text-xl font-bold text-white mb-2">Context-Aware Emotion Recognition</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Bayesian-style context fusion, scene priors, temporal smoothing, and real-time facial emotion analysis.</p>
          </article>

          <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 hover:border-blue-500/50 transition-all">
            <p class="text-blue-400 font-mono text-sm mb-3">02</p>
            <h3 class="text-xl font-bold text-white mb-2">Multimodal Transformers</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Image/audio fusion, cross-attention, hardware-aware inference, and experimental emotion-recognition pipelines.</p>
          </article>

          <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 hover:border-purple-500/50 transition-all">
            <p class="text-purple-400 font-mono text-sm mb-3">03</p>
            <h3 class="text-xl font-bold text-white mb-2">Embedded AI & Smart Sensing</h3>
            <p class="text-slate-400 text-sm leading-relaxed">IoT monitoring, microcontrollers, edge devices, cloud dashboards, and real-time deployment.</p>
          </article>

          <article class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 hover:border-emerald-500/50 transition-all">
            <p class="text-emerald-400 font-mono text-sm mb-3">04</p>
            <h3 class="text-xl font-bold text-white mb-2">Business-Oriented AI Strategy</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Digital platforms and AI workflows aligned with operational efficiency, mission, and long-term institutional goals.</p>
          </article>
        </div>

        <article class="rounded-2xl border border-cyan-500/20 bg-slate-950/70 p-6 relative overflow-hidden min-h-[330px]">
          <div class="absolute inset-0 opacity-25 pointer-events-none algorithm-field"></div>
          <div class="relative z-10">
            <p class="text-xs font-bold text-cyan-400 uppercase tracking-[0.3em] mb-3">Dynamic Profile Kernel</p>
            <h3 class="text-2xl font-bold text-white mb-4">Research profile characteristics</h3>
            <div id="profile-feature-board" class="space-y-3">
              <div class="rounded-xl border border-slate-800 bg-black/40 p-4">
                <p class="text-slate-500 text-xs uppercase tracking-widest">Core capability</p>
                <p class="text-cyan-300 font-mono mt-1">Computer Vision Researcher</p>
              </div>
              <div class="rounded-xl border border-slate-800 bg-black/40 p-4">
                <p class="text-slate-500 text-xs uppercase tracking-widest">Applied direction</p>
                <p class="text-purple-300 font-mono mt-1">AI + Hardware + Strategy</p>
              </div>
              <div class="rounded-xl border border-slate-800 bg-black/40 p-4">
                <p class="text-slate-500 text-xs uppercase tracking-widest">Live focus</p>
                <p id="live-focus" class="text-green-300 font-mono mt-1">Context-aware multimodal intelligence</p>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <TechStackCarousel locale="en" />

    <section id="highlight" class="mt-24">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 border-b border-slate-800 pb-4 mb-10">
        <div>
          <p class="text-xs font-bold text-purple-400 uppercase tracking-[0.3em] mb-2">Research Highlight</p>
          <h2 class="text-3xl font-bold text-white">A Probabilistic Framework for Scene-Context Facial Emotion Recognition</h2>
        </div>
        <p class="text-slate-500 max-w-2xl">
          A dual-stream real-time framework that injects scene context as an explicit probabilistic prior for facial emotion recognition.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[0.95fr_1.05fr] gap-8">
        <article class="rounded-3xl border border-purple-500/25 bg-gradient-to-br from-purple-500/10 via-slate-950/80 to-cyan-500/10 p-6 relative overflow-hidden">
          <div class="absolute inset-0 opacity-25 pointer-events-none research-orbit"></div>
          <div class="relative z-10">
            <div class="flex flex-wrap gap-2 mb-5">
              <span class="pub-badge bg-purple-500/20 text-purple-300 border-purple-500/30">ACCEPTED · IN PRODUCTION</span>
              <span class="pub-badge bg-cyan-500/10 text-cyan-300 border-cyan-500/30">EDGE-READY AI</span>
              <span class="pub-badge bg-green-500/10 text-green-300 border-green-500/30">BCPF FUSION</span>
            </div>

            <h3 class="text-2xl font-bold text-white mb-4">Context as a probabilistic prior</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">
              The framework combines a facial-emotion branch with a scene-context branch. The scene branch estimates seven social environments and uses the resulting posterior as a prior to reweight facial emotion probabilities, reducing implausible emotion-context assignments while preserving real-time behavior.
            </p>

            <div class="grid grid-cols-2 gap-3 mb-6">
              <div class="metric-chip">
                <p class="metric-value">7</p>
                <p class="metric-label">Scene contexts</p>
              </div>
              <div class="metric-chip">
                <p class="metric-value">6</p>
                <p class="metric-label">Emotion classes</p>
              </div>
              <div class="metric-chip">
                <p class="metric-value">30+</p>
                <p class="metric-label">FPS target</p>
              </div>
              <div class="metric-chip">
                <p class="metric-value">PSC</p>
                <p class="metric-label">IDC · ISR · VSC</p>
              </div>
            </div>

            <div class="flex flex-wrap gap-2">
              <span class="tag">YOLO Segmentation</span>
              <span class="tag">MobileNetV2</span>
              <span class="tag">Temporal Smoothing</span>
              <span class="tag">Bayesian Context Fusion</span>
              <span class="tag">Jetson / Raspberry Pi</span>
            </div>
          </div>
        </article>

        <article class="rounded-3xl border border-slate-800 bg-slate-950/80 p-6 relative overflow-hidden">
          <div class="absolute inset-0 opacity-20 pointer-events-none algorithm-field"></div>
          <div class="relative z-10">
            <p class="text-xs font-bold text-cyan-400 uppercase tracking-[0.3em] mb-4">Live Fusion Concept</p>
            <div class="space-y-4">
              <div class="pipeline-node border-cyan-500/30">
                <span class="node-index text-cyan-300">01</span>
                <div>
                  <h4 class="node-title">Face Stream</h4>
                  <p class="node-text">Lightweight CNN estimates a six-way facial emotion posterior.</p>
                </div>
              </div>
              <div class="pipeline-node border-purple-500/30">
                <span class="node-index text-purple-300">02</span>
                <div>
                  <h4 class="node-title">Scene Stream</h4>
                  <p class="node-text">YOLO-based masking and MobileNetV2 classify the social context.</p>
                </div>
              </div>
              <div class="pipeline-node border-green-500/30">
                <span class="node-index text-green-300">03</span>
                <div>
                  <h4 class="node-title">Context Prior Matrix</h4>
                  <p class="node-text">Pctx converts scene probability into an affective compatibility prior.</p>
                </div>
              </div>
              <div class="pipeline-node border-blue-500/30">
                <span class="node-index text-blue-300">04</span>
                <div>
                  <h4 class="node-title">BCPF Output</h4>
                  <p class="node-text">A confidence gate avoids over-correction when context is uncertain.</p>
                </div>
              </div>
            </div>

            <div class="mt-6 rounded-2xl border border-slate-800 bg-black/50 p-4">
              <div class="flex justify-between text-xs text-slate-500 mb-2"><span>Face-only ambiguity</span><span>Fused confidence</span></div>
              <div class="fusion-track"><span class="fusion-bar face-bar"></span></div>
              <div class="fusion-track mt-3"><span class="fusion-bar context-bar"></span></div>
              <div class="fusion-track mt-3"><span class="fusion-bar output-bar"></span></div>
              <div class="grid grid-cols-3 gap-2 mt-3 text-[10px] uppercase tracking-widest text-slate-500">
                <span>Face</span><span>Context</span><span>Output</span>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section class="mt-24 grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-2xl font-bold text-white mb-8 border-b border-slate-800 pb-3">Experience & Strategy</h2>
        <div class="space-y-8">
          <div class="relative pl-4 border-l border-slate-800 hover:border-cyan-500/50 transition-colors">
            <span class="text-xs font-mono text-cyan-400">2026 - Present</span>
            <h3 class="text-lg font-bold text-slate-200 mt-1">Visiting Researcher</h3>
            <p class="text-sm text-slate-400 font-medium">University of British Columbia Okanagan</p>
            <p class="text-slate-400 text-sm mt-2 leading-relaxed">International research stay focused on AI, autonomous systems, sensing, and real-time hardware integration.</p>
          </div>
          <div class="relative pl-4 border-l border-slate-800 hover:border-purple-500/50 transition-colors">
            <span class="text-xs font-mono text-purple-400">2023 - Present</span>
            <h3 class="text-lg font-bold text-slate-200 mt-1">University Professor & Technology Consultant</h3>
            <p class="text-sm text-slate-400 font-medium">Teaching, applied technology, and digital strategy</p>
            <p class="text-slate-400 text-sm mt-2 leading-relaxed">Designing technical courses and advising technology-driven solutions to improve operational efficiency through AI, digital platforms, and automation workflows.</p>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-white mb-8 border-b border-slate-800 pb-3">Education</h2>
        <div class="space-y-8">
          <div class="relative pl-4 border-l border-slate-800 hover:border-blue-500/50 transition-colors">
            <span class="text-xs font-mono text-blue-400">Ongoing · Expected Dec 2027</span>
            <h3 class="text-lg font-bold text-slate-200 mt-1">PhD in Electronics Science</h3>
            <p class="text-sm text-slate-400 font-medium">INAOE</p>
          </div>
          <div class="relative pl-4 border-l border-slate-800 hover:border-blue-500/50 transition-colors">
            <span class="text-xs font-mono text-slate-500">Completed</span>
            <h3 class="text-lg font-bold text-slate-200 mt-1">MSc in Electronics Science</h3>
            <p class="text-sm text-slate-400 font-medium">INAOE</p>
          </div>
          <div class="relative pl-4 border-l border-slate-800 hover:border-blue-500/50 transition-colors">
            <span class="text-xs font-mono text-slate-500">Completed</span>
            <h3 class="text-lg font-bold text-slate-200 mt-1">BSc in Mechatronics Engineering</h3>
            <p class="text-sm text-slate-400 font-medium">Universidad Iberoamericana Puebla</p>
          </div>
          <div class="relative pl-4 border-l border-slate-800 hover:border-blue-500/50 transition-colors">
            <span class="text-xs font-mono text-slate-500">Completed</span>
            <h3 class="text-lg font-bold text-slate-200 mt-1">BSc in Communications and Electronics Engineering</h3>
            <p class="text-sm text-slate-400 font-medium">Universidad Iberoamericana Puebla</p>
          </div>
        </div>
      </div>
    </section>

    <section id="projects" class="mt-24">
      <div class="border-b border-slate-800 pb-4 mb-10">
        <p class="text-xs font-bold text-cyan-400 uppercase tracking-[0.3em] mb-2">Built Systems</p>
        <h2 class="text-3xl font-bold text-white">Technology Development & Projects</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <article class="group rounded-2xl border border-slate-800 bg-slate-900/50 overflow-hidden hover:border-cyan-500/50 transition-all flex flex-col md:col-span-2">
          <div class="h-72 w-full bg-slate-900 relative flex justify-center items-center overflow-hidden">
            <span class="absolute z-10 text-slate-500 font-mono text-sm">Upload: /public/satellite.jpg</span>
            
                        <video
  class="absolute inset-0 w-full h-full object-cover z-20 group-hover:grayscale-0 transition-all duration-500"
  autoplay
  muted
  loop
  playsinline
  preload="auto"
  poster="/portafolio-luis/satellite.jpg"
>
  <source src="/portafolio-luis/satellite-demo.mp4?v=1" type="video/mp4" />
</video>

            <div class="absolute inset-0 z-30 bg-gradient-to-b from-transparent via-cyan-500/25 to-transparent animate-[scan_3.2s_ease-in-out_infinite] pointer-events-none"></div>
            <div class="absolute inset-0 z-30 satellite-grid pointer-events-none"></div>
          </div>
          <div class="p-6">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <h3 class="text-2xl font-bold text-white">Real-Time Satellite Scanning</h3>
              <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded bg-red-500/20 text-red-300 border border-red-500/30">Governmental & Academic Level</span>
            </div>
            <p class="text-slate-400 text-sm mb-4 max-w-4xl leading-relaxed">Development of real-time satellite image processing algorithms for territorial intelligence, environmental monitoring, security-oriented analysis, and academic/governmental applications.</p>
            <div class="flex gap-2 flex-wrap">
              <span class="tag">Scanning Algorithms</span>
              <span class="tag">Remote Sensing</span>
              <span class="tag">Real-Time Processing</span>
              <span class="tag">Territorial Intelligence</span>
            </div>
          </div>
        </article>

        <article class="group rounded-2xl border border-slate-800 bg-slate-900/50 overflow-hidden hover:border-yellow-500/50 transition-all flex flex-col">
          <div class="h-64 w-full bg-slate-900 relative overflow-hidden drone-radar">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(168,85,247,0.20),transparent_40%)]"></div>
            <div class="absolute inset-0 drone-grid"></div>
            <div class="drone-path"><span class="drone-dot">✦</span></div>
            <video
  class="absolute inset-0 w-full h-full object-cover z-20 opacity-100 over:grayscale-0 transition-all duration-500" 
  autoplay
  muted
  loop
  playsinline
  preload="auto"
  poster="/portafolio-luis/drone.jpg"
>
  <source src="/portafolio-luis/drone-demo.mp4?v=99" type="video/mp4" />
</video>
            <div class="absolute bottom-4 left-4 right-4 z-20 text-xs font-mono text-purple-200/80">tracking.init(target='aerial_object', mode='research')</div>
          </div>
          <div class="p-6 flex-grow flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <h3 class="text-xl font-bold text-white">Aerial Systems & Autonomous Drones</h3>
                <span class="px-2 py-0.5 text-[10px] font-bold uppercase rounded bg-purple-500/20 text-purple-300 border border-purple-500/30">Academic + Enterprise</span>
              </div>
              <p class="text-slate-400 text-sm mb-4 leading-relaxed">Autonomous drone operation, navigation logic, real-time tracking, and computer-vision control pipelines for research, field testing, and enterprise-oriented aerial intelligence systems.</p>
            </div>
            <div class="flex gap-2 flex-wrap">
              <span class="tag">Autonomous Navigation</span>
              <span class="tag">GCS Control</span>
              <span class="tag">Real-Time Tracking</span>
            </div>
          </div>
        </article>

        <article class="group rounded-2xl border border-slate-800 bg-slate-900/50 overflow-hidden hover:border-yellow-500/50 transition-all flex flex-col">

            <div class="h-64 w-full bg-slate-950 relative overflow-hidden">
  <video
    class="absolute inset-0 w-full h-full object-cover z-20 opacity-100 group-hover:grayscale-0 transition-all duration-500"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
  >
    <source src="/portafolio-luis/parkade-demo-h264.mp4?v=1" type="video/mp4" />
  </video>

  <div class="absolute inset-0 z-30 bg-gradient-to-t from-black/70 via-transparent to-transparent pointer-events-none"></div>

  <div class="absolute top-3 left-3 z-40 px-3 py-1 rounded-full border border-yellow-500/40 bg-black/70 text-yellow-300 text-xs font-mono">
    BERKELEY 2ND PLACE
  </div>

  <div class="absolute bottom-3 left-3 z-40 px-3 py-1 rounded-full border border-cyan-500/40 bg-black/70 text-cyan-300 text-xs font-mono">
    AI PARKING OCCUPANCY VISUALIZATION
  </div>
</div>

         <div class="p-6 flex-grow flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <h3 class="text-xl font-bold text-white">Smart Parkade System</h3>
                <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded bg-yellow-500/20 text-yellow-300 border border-yellow-500/30">Berkeley 2nd Place</span>

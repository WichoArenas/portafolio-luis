  .group:hover .pcb-image {
    transform: scale(1.04);
    filter: saturate(1.08) contrast(1.08) brightness(1.03);
  }

  .pcb-scan-line {
    position: absolute;
    top: -20%;
    left: -20%;
    width: 140%;
    height: 28%;
    background: linear-gradient(
      180deg,
      rgba(34, 211, 238, 0) 0%,
      rgba(34, 211, 238, 0.18) 45%,
      rgba(34, 211, 238, 0.35) 50%,
      rgba(34, 211, 238, 0.18) 55%,
      rgba(34, 211, 238, 0) 100%
    );
    transform: rotate(-8deg);
    animation: pcbScanMove 4.5s linear infinite;
  }

  @keyframes pcbScanMove {
    0% {
      transform: translateY(-140%) rotate(-8deg);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: translateY(320%) rotate(-8deg);
      opacity: 0;
    }
  }

  .pcb-node {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    background: #22d3ee;
    box-shadow:
      0 0 0 0 rgba(34, 211, 238, 0.55),
      0 0 12px rgba(34, 211, 238, 0.9),
      0 0 24px rgba(34, 211, 238, 0.45);
    animation: pcbPulse 2.2s infinite ease-in-out;
  }

  .pcb-node-delay-1 {
    animation-delay: 0.4s;
  }

  .pcb-node-delay-2 {
    animation-delay: 0.9s;
  }

  .pcb-node-delay-3 {
    animation-delay: 1.3s;
  }

  @keyframes pcbPulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.45);
      opacity: 1;
    }
  }

</style>

<script is:inline>
  const ORCID_ID = "0009-0006-5247-3629";
  const ORCID_URL = `https://pub.orcid.org/v3.0/${ORCID_ID}/works`;

  const manualCitationSources = [
    {
      key: "ieee-saqms",
      doi: "10.1109/MIM.2026.11224834",
      badgeId: "citation-ieee-saqms"
    }
  ];

  const typewriterPhrases = [
    "Computer Vision Researcher",
    "Multimodal AI Developer",
    "Embedded Intelligence Builder",
    "Scene-Context Facial Emotion Recognition",
    "Context-Aware Emotion Recognition",
    "IoT + Smart Sensing Systems",
    "Real-Time AI on Hardware",
    "Business-Oriented AI Strategy",
    "Drone + Satellite Intelligence"
  ];

  const terminalStatusMessages = [
    "ORCID public record connected.",
    "DOI citation counter enabled when metadata exists.",
    "Accepted manuscripts remain paused until official indexing.",
    "IEEE, ORCID, DOI, Hackster and magazine links are preserved.",
    "Portfolio running as a static GitHub Pages site.",
    "PCB, drone, satellite and BCPF fusion visuals initialized."
  ];

  const focusPhrases = [
    "Scene-context facial emotion recognition",
    "Context-aware multimodal intelligence",
    "Real-time drone tracking pipelines",
    "Satellite image scanning algorithms",
    "Embedded AI and smart sensing platforms",
    "AI-driven business process optimization",
    "Hardware/software synchronized systems"
  ];

  const escapeHTML = (value) => String(value ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");

  const normalize = (value) => String(value ?? "").toLowerCase().replace(/\s+/g, " ").trim();

  function readCache(key, maxAgeMs = 12 * 60 * 60 * 1000) {
    try {
      const cached = JSON.parse(localStorage.getItem(key));
      if (!cached) return null;
      if (Date.now() - cached.timestamp > maxAgeMs) return null;
      return cached.value;
    } catch {
      return null;
    }
  }

  function writeCache(key, value) {
    try {
      localStorage.setItem(key, JSON.stringify({ timestamp: Date.now(), value }));
    } catch {
      // Cache is optional.
    }
  }

  async function fetchCitationCountByDoi(doi) {
    if (!doi) return null;

    const normalizedDoi = doi.trim().toLowerCase();
    const cacheKey = `portfolio:citation:${normalizedDoi}`;
    const cached = readCache(cacheKey);
    if (typeof cached === "number") return cached;

    try {
      const paperId = encodeURIComponent(`DOI:${normalizedDoi}`);
      const response = await fetch(`https://api.semanticscholar.org/graph/v1/paper/${paperId}?fields=citationCount,title,year,url`);
      if (response.ok) {
        const data = await response.json();
        if (typeof data.citationCount === "number") {
          writeCache(cacheKey, data.citationCount);
          return data.citationCount;
        }
      }
    } catch {
      // Continue to Crossref fallback.
    }

    try {
      const response = await fetch(`https://api.crossref.org/works/${encodeURIComponent(normalizedDoi)}`);
      if (response.ok) {
        const data = await response.json();
        const count = data?.message?.["is-referenced-by-count"];
        if (typeof count === "number") {
          writeCache(cacheKey, count);
          return count;
        }
      }
    } catch {
      // Citation count is optional.
    }

    return null;
  }

  function extractExternalId(summary, preferredType) {
    const ids = summary?.["external-ids"]?.["external-id"] ?? [];
    const match = ids.find((item) => normalize(item?.["external-id-type"]) === preferredType);
    return match ?? null;
  }

  function externalLinkFromSummary(summary) {
    const directUrl = summary?.url?.value;
    if (directUrl) return directUrl;

    const doi = extractExternalId(summary, "doi");
    const doiUrl = doi?.["external-id-url"]?.value;
    if (doiUrl) return doiUrl;

    const doiValue = doi?.["external-id-value"];
    if (doiValue) return `https://doi.org/${doiValue}`;

    const anyUrl = (summary?.["external-ids"]?.["external-id"] ?? [])
      .find((item) => item?.["external-id-url"]?.value)?.["external-id-url"]?.value;

    return anyUrl || null;
  }

  function renderOrcidCard({ title, year, type, link, doi, citationCount }) {
    const safeTitle = escapeHTML(title);
    const safeType = escapeHTML(type || "WORK");
    const safeYear = escapeHTML(year || "N/A");
    const safeLink = link ? escapeHTML(link) : null;
    const safeDoi = doi ? escapeHTML(doi) : null;

    return `
      <article class="p-5 rounded-xl border border-slate-800 bg-slate-900/40 hover:bg-slate-800/50 transition-colors group">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <div class="flex flex-wrap items-center gap-3 mb-1">
              <span class="px-2 py-0.5 text-[10px] font-bold tracking-wider rounded bg-green-500/10 text-green-300 border border-green-500/20">${safeType}</span>
              <span class="text-sm font-mono text-slate-500">${safeYear}</span>
              <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-slate-800 text-slate-300 border border-slate-700">Citations: ${citationCount ?? "—"}</span>
            </div>
            <h3 class="text-lg font-bold text-slate-200 group-hover:text-cyan-300 transition-colors">${safeTitle}</h3>
            ${safeDoi ? `<p class="text-xs text-slate-500 mt-2">DOI: ${safeDoi}</p>` : ""}
          </div>
          ${safeLink ? `<a href="${safeLink}" target="_blank" rel="noopener noreferrer" class="shrink-0 px-4 py-2 text-sm rounded-lg border border-slate-700 hover:border-cyan-500 text-slate-300 hover:text-cyan-300 transition-colors">Open record &rarr;</a>` : ""}
        </div>
      </article>
    `;
  }

  async function updateManualCitationBadges() {
    let total = 0;

    for (const item of manualCitationSources) {
      const count = await fetchCitationCountByDoi(item.doi);
      const badge = document.getElementById(item.badgeId);
      if (badge) badge.textContent = `Citations: ${count ?? "—"}`;
      if (typeof count === "number") total += count;
    }

    return total;
  }

  async function fetchOrcidWorks() {
    const container = document.getElementById("orcid-publications");
    const publicationMetric = document.getElementById("metric-publications");
    const citationMetric = document.getElementById("metric-citations");
    const updatedMetric = document.getElementById("metric-updated");
    const pendingPaper = document.getElementById("pending-accepted-paper");

    if (!container) return;

    let totalCitations = await updateManualCitationBadges();
    let renderedCount = 2; // IEEE + Revista Latinoamericana curated entries.

    try {
      const response = await fetch(ORCID_URL, { headers: { "Accept": "application/json" } });
      if (!response.ok) throw new Error("Unable to connect to ORCID public API.");

      const data = await response.json();
      const groups = data?.group ?? [];

      const renderedTitles = new Set([
        normalize("Education in I&M: Smart Air Quality Monitoring System — A Student Project"),
        normalize("Smart Air Quality Monitoring System - a Student Project"),
        normalize("Revista Latinoamericana Publication"),
        normalize("A Probabilistic Framework for Scene-Context Facial Emotion Recognition")
      ]);

      const cards = [];

      for (const workGroup of groups) {
        const summary = workGroup?.["work-summary"]?.[0];
        if (!summary?.title?.title?.value) continue;

        const title = summary.title.title.value;
        const normalizedTitle = normalize(title);

        if ([...renderedTitles].some((existing) => normalizedTitle.includes(existing) || existing.includes(normalizedTitle))) {
          continue;
        }

        if ((normalizedTitle.includes("context-aware emotion") || normalizedTitle.includes("probabilistic framework") || normalizedTitle.includes("scene-context facial emotion")) && pendingPaper) {
          pendingPaper.style.display = "none";
        }

        const year = summary?.["publication-date"]?.year?.value ?? "N/A";
        const type = String(summary?.type ?? "work").replaceAll("_", " ").toUpperCase();
        const link = externalLinkFromSummary(summary);
        const doi = extractExternalId(summary, "doi")?.["external-id-value"] ?? null;
        const citationCount = await fetchCitationCountByDoi(doi);

        if (typeof citationCount === "number") totalCitations += citationCount;
        renderedCount += 1;

        cards.push(renderOrcidCard({ title, year, type, link, doi, citationCount }));
      }

      if (cards.length === 0) {
        container.innerHTML = `
          <p class="text-slate-500">
            No additional ORCID works were found beyond the curated entries, or ORCID is still indexing the records.
          </p>
        `;
      } else {
        container.innerHTML = cards.join("");
      }

      if (publicationMetric) publicationMetric.textContent = String(renderedCount);
      if (citationMetric) citationMetric.textContent = totalCitations ? String(totalCitations) : "—";
      if (updatedMetric) updatedMetric.textContent = new Date().toLocaleDateString(undefined, { month: "short", day: "numeric" });
    } catch (error) {
      console.error(error);
      container.innerHTML = `
        <p class="text-red-400">
          Dynamic ORCID loading failed. Please use the direct ORCID and IEEE links above.
        </p>
      `;
      if (publicationMetric) publicationMetric.textContent = String(renderedCount);
      if (citationMetric) citationMetric.textContent = totalCitations ? String(totalCitations) : "—";
    }
  }

  function startTypewriter() {
    const target = document.getElementById("typewriter");
    if (!target) return;

    let phraseIndex = 0;
    let charIndex = 0;
    let deleting = false;

    function tick() {
      const phrase = typewriterPhrases[phraseIndex];

      if (deleting) {
        target.textContent = phrase.substring(0, charIndex - 1);
        charIndex -= 1;
      } else {
        target.textContent = phrase.substring(0, charIndex + 1);
        charIndex += 1;
      }

      let speed = deleting ? 30 : 65;

      if (!deleting && charIndex === phrase.length) {
        speed = 1700;
        deleting = true;
      } else if (deleting && charIndex === 0) {
        deleting = false;
        phraseIndex = (phraseIndex + 1) % typewriterPhrases.length;
        speed = 350;
      }

      setTimeout(tick, speed);
    }

    tick();
  }

  function startTerminalStatus() {
    const target = document.getElementById("terminal-status");
    if (!target) return;

    let index = 0;
    setInterval(() => {
      index = (index + 1) % terminalStatusMessages.length;
      target.textContent = terminalStatusMessages[index];
    }, 2600);
  }

  function startLiveFocus() {
    const target = document.getElementById("live-focus");
    if (!target) return;

    let index = 0;
    setInterval(() => {
      index = (index + 1) % focusPhrases.length;
      target.textContent = focusPhrases[index];
    }, 2800);
  }

  function startNeuralBackground() {
    const canvas = document.getElementById("neural-bg");
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }

    resize();

    const particles = Array.from({ length: 82 }, () => ({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      vx: (Math.random() - 0.5) * 0.45,
      vy: (Math.random() - 0.5) * 0.45,
      radius: Math.random() * 2 + 0.5
    }));

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      for (let i = 0; i < particles.length; i++) {
        const particle = particles[i];

        particle.x += particle.vx;
        particle.y += particle.vy;

        if (particle.x < 0 || particle.x > canvas.width) particle.vx *= -1;
        if (particle.y < 0 || particle.y > canvas.height) particle.vy *= -1;

        ctx.beginPath();
        ctx.arc(particle.x, particle.y, particle.radius, 0, Math.PI * 2);
        ctx.fillStyle = "#06b6d4";
        ctx.fill();

        for (let j = i + 1; j < particles.length; j++) {
          const other = particles[j];
          const dx = particle.x - other.x;
          const dy = particle.y - other.y;
          const distance = Math.sqrt(dx * dx + dy * dy);

          if (distance < 145) {
            ctx.beginPath();
            ctx.strokeStyle = `rgba(6, 182, 212, ${1 - distance / 145})`;
            ctx.lineWidth = 0.45;
            ctx.moveTo(particle.x, particle.y);
            ctx.lineTo(other.x, other.y);
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(draw);
    }

    window.addEventListener("resize", resize);
    draw();
  }

  document.addEventListener("DOMContentLoaded", () => {
    startTypewriter();
    startTerminalStatus();
    startLiveFocus();
    startNeuralBackground();
    fetchOrcidWorks();
  });
</script>

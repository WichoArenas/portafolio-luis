    color: rgb(148, 163, 184);
  }

  .research-orbit {
    background:
      radial-gradient(circle at center, rgba(168,85,247,0.22), transparent 28%),
      conic-gradient(from 90deg, transparent 0deg, rgba(6,182,212,0.20) 70deg, transparent 140deg, rgba(168,85,247,0.16) 230deg, transparent 360deg);
    animation: algorithmSpin 24s linear infinite;
  }

  .fusion-track {
    height: 0.6rem;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(30, 41, 59, 0.9);
    border: 1px solid rgba(51, 65, 85, 0.8);
  }

  .fusion-bar {
    display: block;
    height: 100%;
    border-radius: 999px;
    transform-origin: left;
    animation: fusionPulse 3.8s ease-in-out infinite;
  }

  .face-bar { width: 42%; background: linear-gradient(90deg, rgba(248,113,113,0.85), rgba(251,191,36,0.85)); }
  .context-bar { width: 66%; background: linear-gradient(90deg, rgba(168,85,247,0.85), rgba(6,182,212,0.85)); animation-delay: 0.35s; }
  .output-bar { width: 82%; background: linear-gradient(90deg, rgba(34,197,94,0.85), rgba(6,182,212,0.95)); animation-delay: 0.7s; }

  @keyframes fusionPulse {
    0%, 100% { transform: scaleX(0.72); opacity: 0.72; }
    50% { transform: scaleX(1); opacity: 1; }
  }

  .pcb-panel {
    isolation: isolate;
  }

  .pcb-image {
    transform: scale(1.01);
    transition: transform 0.6s ease, filter 0.6s ease;
    filter: saturate(0.95) contrast(1.02);
